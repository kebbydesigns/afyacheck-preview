---
layout: layouts/content.njk
dataSource: whatWeDo.focusAreas
dataView: page
permalink: /what-we-do/focus-areas/
tags:
  - contentPage
eleventyComputed:
  title: '{{ whatWeDo.focusAreas.title | safe }}'
  description: '{{ whatWeDo.focusAreas.description | safe }}'
  breadcrumbs:
    - url: /what-we-do/
      title: '{{ (whatWeDo.overview).title | safe }}'
  action:
    url: '{{ whatWeDo.focusAreas.action.url }}'
    label: '{{ whatWeDo.focusAreas.action.label | safe }}'
---

{% set pageContent = whatWeDo.focusAreas %}

{# Our focus areas: layout belongs here; copy comes from the section JSON. #}
<section class="content-section" aria-labelledby="section-1">
  <div class="content-inner">
    <div class="section-introduction">
      <div class="section-copy">
        <h2 id="section-1">{{ pageContent.sections[0].headings[0] }}</h2>
        <p>{{ pageContent.sections[0].paragraphs[0] }}</p>
      </div>
    </div>
    {% set cardReferences = pageContent.sections[0].cards %}
    {% include "partials/section-cards.njk" %}
  </div>
</section>
