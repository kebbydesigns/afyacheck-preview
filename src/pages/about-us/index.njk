---
layout: layouts/content.njk
dataSource: about.overview
dataView: page
permalink: /about/
tags:
  - contentPage
eleventyComputed:
  title: '{{ about.overview.title | safe }}'
  description: '{{ about.overview.description | safe }}'
  breadcrumbs: []
---

{% set pageContent = about.overview %}

{# Our mission: layout belongs here; copy comes from the section JSON. #}
<section class="content-section" aria-labelledby="section-1">
  <div class="content-inner">
    <div class="section-introduction">
      <div class="section-copy">
        <h2 id="section-1">{{ pageContent.sections[0].headings[0] }}</h2>
        <p>{{ pageContent.sections[0].paragraphs[0] }}</p>
      </div>
      <div class="section-media">
        <img
          src="{{ pageContent.sections[0].attributes[0].value }}"
          alt="{{ pageContent.sections[0].attributes[1].value }}"
          width="640"
          height="357"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
    {% set cardReferences = pageContent.sections[0].cards %}
    {% include "partials/section-cards.njk" %}
  </div>
</section>

{# Get to know AfyaCheck: layout belongs here; copy comes from the section JSON. #}
<section class="content-section" aria-labelledby="section-2">
  <div class="content-inner">
    <div class="section-introduction">
      <div class="section-copy">
        <h2 id="section-2">{{ pageContent.sections[1].headings[0] }}</h2>
        <p>{{ pageContent.sections[1].paragraphs[0] }}</p>
      </div>
    </div>
    {% set cardReferences = pageContent.sections[1].cards %}
    {% include "partials/section-cards.njk" %}
  </div>
</section>
