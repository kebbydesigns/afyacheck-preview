---
layout: layouts/content.njk
dataSource: about.story
dataView: page
permalink: /about/our-story/
tags:
  - contentPage
eleventyComputed:
  title: '{{ about.story.title | safe }}'
  description: '{{ about.story.description | safe }}'
  breadcrumbs:
    - url: /about/
      title: '{{ (about.overview).title | safe }}'
---

{% set pageContent = about.story %}

{# 2018 · Starting locally: layout belongs here; copy comes from the section JSON. #}
<section class="content-section" aria-labelledby="section-1">
  <div class="content-inner">
    <div class="section-introduction">
      <div class="section-copy">
        <h2 id="section-1">{{ pageContent.sections[0].headings[0] }}</h2>
        <p>{{ pageContent.sections[0].paragraphs[0] }}</p>
      </div>
    </div>
  </div>
</section>

{# 2021 · Taking care on the road: layout belongs here; copy comes from the section JSON. #}
<section class="content-section" aria-labelledby="section-2">
  <div class="content-inner">
    <div class="section-introduction">
      <div class="section-copy">
        <h2 id="section-2">{{ pageContent.sections[1].headings[0] }}</h2>
        <p>{{ pageContent.sections[1].paragraphs[0] }}</p>
      </div>
      <div class="section-media">
        <img
          src="{{ pageContent.sections[1].attributes[0].value }}"
          alt="{{ pageContent.sections[1].attributes[1].value }}"
          width="640"
          height="478"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

{# The next chapter: layout belongs here; copy comes from the section JSON. #}
<section class="content-section" aria-labelledby="section-3">
  <div class="content-inner">
    <div class="section-introduction">
      <div class="section-copy">
        <h2 id="section-3">{{ pageContent.sections[2].headings[0] }}</h2>
        <p>{{ pageContent.sections[2].paragraphs[0] }}</p>
      </div>
    </div>
    {% set cardReferences = pageContent.sections[2].cards %}
    {% include "partials/section-cards.njk" %}
  </div>
</section>
