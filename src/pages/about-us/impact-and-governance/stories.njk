---
layout: layouts/content.njk
dataSource: about.impact.stories
dataView: page
permalink: /about/impact-and-governance/stories/
tags:
  - contentPage
eleventyComputed:
  title: '{{ about.impact.stories.title | safe }}'
  description: '{{ about.impact.stories.description | safe }}'
  breadcrumbs:
    - url: /about/
      title: '{{ (about.overview).title | safe }}'
    - url: /about/impact-and-governance/
      title: '{{ (about.impact.overview).title | safe }}'
---

{% set pageContent = about.impact.stories %}

{# A health check at a familiar gathering place: layout belongs here; copy comes from the section JSON. #}
<section class="content-section" aria-labelledby="section-1">
  <div class="content-inner">
    <div class="section-introduction">
      <div class="section-copy">
        <h2 id="section-1">{{ pageContent.sections[0].headings[0] }}</h2>
        <p>{{ pageContent.sections[0].paragraphs[0] }}</p>
      </div>
    </div>
  </div>
</section>

{# Making a referral easier to follow: layout belongs here; copy comes from the section JSON. #}
<section class="content-section" aria-labelledby="section-2">
  <div class="content-inner">
    <div class="section-introduction">
      <div class="section-copy">
        <h2 id="section-2">{{ pageContent.sections[1].headings[0] }}</h2>
        <p>{{ pageContent.sections[1].paragraphs[0] }}</p>
      </div>
    </div>
  </div>
</section>

{# Share a story responsibly: layout belongs here; copy comes from the section JSON. #}
<section class="content-section" aria-labelledby="section-3">
  <div class="content-inner">
    <div class="section-introduction">
      <div class="section-copy">
        <h2 id="section-3">{{ pageContent.sections[2].headings[0] }}</h2>
        <p>{{ pageContent.sections[2].paragraphs[0] }}</p>
      </div>
    </div>
    {% set cardReferences = pageContent.sections[2].cards %}
    {% include "partials/section-cards.njk" %}
  </div>
</section>
