---
layout: layouts/content.njk
dataSource: about.impact.overview
dataView: page
permalink: /about/impact-and-governance/
tags:
  - contentPage
eleventyComputed:
  title: '{{ about.impact.overview.title | safe }}'
  description: '{{ about.impact.overview.description | safe }}'
  breadcrumbs:
    - url: /about/
      title: '{{ (about.overview).title | safe }}'
---

{% set pageContent = about.impact.overview %}

{# Looking beyond a screening count: layout belongs here; copy comes from the section JSON. #}
<section class="content-section" aria-labelledby="section-1">
  <div class="content-inner">
    <div class="section-introduction">
      <div class="section-copy">
        <h2 id="section-1">{{ pageContent.sections[0].headings[0] }}</h2>
        <p>{{ pageContent.sections[0].paragraphs[0] }}</p>
      </div>
    </div>
    {% set cardReferences = pageContent.sections[0].cards %}
    {% include "partials/section-cards.njk" %}
  </div>
</section>

{# Proposed governance principles: layout belongs here; copy comes from the section JSON. #}
<section class="content-section" aria-labelledby="section-2">
  <div class="content-inner">
    <div class="section-introduction">
      <div class="section-copy">
        <h2 id="section-2">{{ pageContent.sections[1].headings[0] }}</h2>
        <p>{{ pageContent.sections[1].paragraphs[0] }}</p>
        <ul class="section-list">
          {% for item in pageContent.sections[1].lists[0] %}
            <li>
              {{ item }}
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>
