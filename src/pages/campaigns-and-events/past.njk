---
layout: layouts/content.njk
dataSource: campaigns.past
dataView: page
permalink: /campaigns/past/
tags:
  - contentPage
eleventyComputed:
  title: '{{ campaigns.past.title | safe }}'
  description: '{{ campaigns.past.description | safe }}'
  breadcrumbs:
    - url: /campaigns/
      title: '{{ (campaigns.index).title | safe }}'
---

{% set pageContent = campaigns.past %}

{# Campaign archive: layout belongs here; copy comes from the section JSON. #}
<section class="content-section" aria-labelledby="section-1">
  <div class="content-inner">
    <div class="section-introduction">
      <div class="section-copy">
        <h2 id="section-1">{{ pageContent.sections[0].headings[0] }}</h2>
        <p>{{ pageContent.sections[0].paragraphs[0] }}</p>
      </div>
    </div>
    {% set cards = campaigns | campaignCards("past") %}
    {% include "partials/content-cards.njk" %}
  </div>
</section>
