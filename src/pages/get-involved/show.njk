---
layout: layouts/content.njk
dataSource: getInvolved
dataView: show
pagination:
  data: getInvolved.items
  size: 1
  alias: pageContent
  addAllPagesToCollections: true
permalink: '{{ pageContent.url }}'
tags:
  - contentPage
eleventyComputed:
  title: '{{ pageContent.title | safe }}'
  description: '{{ pageContent.description | safe }}'
  breadcrumbs:
    - url: /get-involved/
      title: '{{ (getInvolved.index).title | safe }}'
  enquiryType: '{{ pageContent.enquiryType }}'
---

{# How this pathway works: layout belongs here; copy comes from the section JSON. #}
<section class="content-section" aria-labelledby="section-1">
  <div class="content-inner">
    <div class="section-introduction">
      <div class="section-copy">
        <h2 id="section-1">{{ pageContent.sections[0].headings[0] }}</h2>
        <p>{{ pageContent.sections[0].paragraphs[0] }}</p>
        <ul class="section-list">
          {% for item in pageContent.sections[0].lists[0] %}
            <li>
              {{ item }}
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>
{% if pageContent.sections[1] %}
  {# Support enquiry only: layout belongs here; copy comes from the section JSON. #}
  <section class="content-section" aria-labelledby="section-2">
    <div class="content-inner">
      <div class="section-introduction">
        <div class="section-copy">
          <h2 id="section-2">{{ pageContent.sections[1].headings[0] }}</h2>
          <p>{{ pageContent.sections[1].paragraphs[0] }}</p>
        </div>
      </div>
    </div>
  </section>
{% endif %}
{% include "partials/demo-enquiry.njk" %}
