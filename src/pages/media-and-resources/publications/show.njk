---
layout: layouts/content.njk
mediaSource: publications
mediaView: show
pagination:
  data: mediaResources.publications.items
  size: 1
  alias: resource
  addAllPagesToCollections: true
permalink: "/media-and-resources/publications/{{ resource.slug }}/"
tags: [contentPage]
eleventyComputed:
  title: "{{ resource.title | safe }}"
  description: "{{ resource.description | safe }}"
  breadcrumbs:
    - url: /media-and-resources/
      title: "{{ mediaResources.overview.title | safe }}"
    - url: "{{ mediaResources.publications.index.url }}"
      title: "{{ mediaResources.publications.index.title | safe }}"
---

{% set group = mediaResources.publications %}

{# Publication summary: keep layout here and edit its copy in mediaResources.json. #}
<section class="content-section" aria-labelledby="section-1">
  <div class="content-inner">
    <div class="section-introduction">
      <div class="section-copy">
        <h2 id="section-1">{{ resource.sections[0].heading }}</h2>
        <p>{{ resource | resourceMetadata(group) }}</p>
        <p class="section-note">{{ resource.sections[0].note }}</p>
      </div>
    </div>
  </div>
</section>

{# Related records: reuse the directory data and exclude this page. #}
<section
  class="content-section related-section"
  aria-labelledby="related-heading"
>
  <div class="content-inner">
    <div class="section-introduction">
      <div class="section-copy">
        <h2 id="related-heading">{{ group.relatedHeading }}</h2>
      </div>
    </div>
    {% set cards = group | resourceCards(resource.slug) %}
    {% include "partials/content-cards.njk" %}
  </div>
</section>
