---
layout: layouts/content.njk
mediaSource: newsroom.index
mediaView: page
permalink: /media-and-resources/newsroom/
tags: [contentPage]
eleventyComputed:
  title: "{{ mediaResources.newsroom.index.title | safe }}"
  description: "{{ mediaResources.newsroom.index.description | safe }}"
  breadcrumbs:
    - url: /media-and-resources/
      title: "{{ mediaResources.overview.title | safe }}"
---

{% set group = mediaResources.newsroom %}

{# Demo dispatches: keep layout here and edit its copy in mediaResources.json. #}
<section class="content-section" aria-labelledby="section-1">
  <div class="content-inner">
    <div class="section-introduction">
      <div class="section-copy">
        <h2 id="section-1">
          {{ mediaResources.newsroom.index.sections[0].heading }}
        </h2>
        <p>{{ mediaResources.newsroom.index.sections[0].text }}</p>
      </div>
    </div>
    {% set cards = group | resourceCards %}
    {% include "partials/content-cards.njk" %}
  </div>
</section>

{# For journalists: keep layout here and edit its copy in mediaResources.json. #}
<section class="content-section" aria-labelledby="section-2">
  <div class="content-inner">
    <div class="section-introduction">
      <div class="section-copy">
        <h2 id="section-2">
          {{ mediaResources.newsroom.index.sections[1].heading }}
        </h2>
        <p>{{ mediaResources.newsroom.index.sections[1].text }}</p>
      </div>
    </div>
    {% set cards = mediaResources.newsroom.index.sections[1].cards %}
    {% include "partials/content-cards.njk" %}
  </div>
</section>
